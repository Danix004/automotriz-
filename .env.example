# Copia este archivo como `.env` y completa los valores.
# .env está en .gitignore: NUNCA se sube a GitHub.

# ── Frontend ────────────────────────────────────────────────────────────
# Vacío  → la app usa el mock local (datos de demostración en localStorage).
# `/api` → la app consume la API serverless de Vercel (TiDB).
# En desarrollo local con `vercel dev` también puedes usar `/api`.
VITE_API_URL=

# ── Base de datos (TiDB Cloud) ──────────────────────────────────────────
# Cadena de conexión de TiDB: Settings → Connect → General
# mysql://USUARIO:PASSWORD@gatewayXX.region.prod.aws.tidbcloud.com:4000/nombre_db
DATABASE_URL=

# Límite de conexiones de la pool (opcional)
DB_CONNECTION_LIMIT=5

# Cambia a "false" solo si tu certificado TLS no es público (no recomendado)
DB_SSL_REJECT_UNAUTHORIZED=true
