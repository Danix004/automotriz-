{
  "name": "autoequip-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema profesional de gestion de equipamientos y accesorios para automoviles",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate-barcode.mjs",
    "test:api": "node --env-file=.env scripts/test-api.mjs",
    "test:mock": "node scripts/test-mock.mjs",
    "test:remote": "node scripts/test-remote.mjs",
    "test": "npm run typecheck && npm run test:mock",
    "dev:api": "vercel dev",
    "clean": "node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
